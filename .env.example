# -----------------------------------------------------------------------------
# Format notes (avoid common mistakes):
# - URLs: use without a trailing slash. The app appends paths (e.g. /api/eventjson, /events).
#   Good: https://api.example.com   Bad: https://api.example.com/
# - Comma-separated lists (e.g. ALLOWED_IMAGE_DOMAINS): use commas only, no spaces.
#   Good: domain1.com,domain2.com   Optional: domain1.com, domain2.com
# -----------------------------------------------------------------------------

# Announcement banner API (base URL and token).
# URL: no trailing slash.
NEXT_PUBLIC_ANNOUNCEMENT_API_URL=https://announcements.example.com/v1
NEXT_PUBLIC_ANNOUNCEMENT_API_TOKEN=your_announcement_bearer_token

# IRL / attendees site. Full URL; with or without trailing slash is fine.
NEXT_PUBLIC_IRL_URL=https://irl.example.com

NEXT_PUBLIC_TINA_CLIENT_ID=
TINA_TOKEN=

# Set by CI (Netlify/Vercel/GitHub); override if needed.
NEXT_PUBLIC_TINA_BRANCH=main

# Comma-separated hostnames for next/image. No spaces (or spaces after commas only).
# Example: example.com,cdn.example.com,images.example.com
ALLOWED_IMAGE_DOMAINS=

# Events/calendar web API. Base URL only; no trailing slash (app appends /events, /events/months).
# Example: https://api.example.com
WEB_API_BASE_URL=

# Bearer token for the web API above.
WEB_API_TOKEN=

EVENT_CLIENT_ID=
EVENT_CLIENT_SECRET=

# CARTO raster basemaps (Leaflet map view). Request at https://carto.com/basemaps/apikey
# for each domain you serve the map on. Exposed to the client (tile URLs).
NEXT_PUBLIC_CARTO_API_KEY=

# PostHog. Host is typically https://app.posthog.com (no trailing slash).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# This app's public URL (for server-side fetches to own API). No trailing slash.
# Example: https://events.example.com
NEXT_PUBLIC_BASE_URL=

# Bearer token for POST /api/revalidate. Used server-side only.
REVALIDATE_TOKEN=

# Auth API (if used). Base URL; no trailing slash.
AUTH_API_BASE_URL=
AUTH_APP_CLIENT_ID=
AUTH_APP_CLIENT_SECRET=

# Origin sent to the web API. Usually this app's domain, e.g. https://events.example.com (no trailing slash).
ORIGIN_DOMAIN=

# Directory API (e.g. IRL locations). Base URL; no trailing slash (app appends /v1/internals/irl/locations).
# Example: https://directory.example.com
DIRECTORY_API_URL=
DIRECTORY_API_TOKEN=

# Agenda refresh and "submit event" link (if used). Full URL; trailing slash optional.
# EVENT_AGENDA_REFRESH_URL=https://api.example.com/api/event
# SUBMIT_EVENT_URL=https://example.com/submit-event
